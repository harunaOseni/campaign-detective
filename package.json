{
  "name": "campaign-detective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "backend": "tsx scripts/start.ts",
    "setup": "docker compose up -d --wait && tsx scripts/setup.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@openai/agents": "^0.21.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
